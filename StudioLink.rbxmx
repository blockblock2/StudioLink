local theme = settings().Studio.Theme
local function color(c, mod)
	return theme:GetColor(c, mod or Enum.StudioStyleGuideModifier.Default)
end

local root = Instance.new("ScrollingFrame")
root.Size = UDim2.fromScale(1, 1)
root.BorderSizePixel = 0
root.ScrollBarThickness = 6
root.AutomaticCanvasSize = Enum.AutomaticSize.Y
root.CanvasSize = UDim2.new()
root.Parent = widget

local pad = Instance.new("UIPadding")
pad.PaddingTop = UDim.new(0, 10)
pad.PaddingBottom = UDim.new(0, 10)
pad.PaddingLeft = UDim.new(0, 10)
pad.PaddingRight = UDim.new(0, 10)
pad.Parent = root

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = root

local themed = {}
local order = 0
local function nextOrder()
	order += 1
	return order
end

local function label(text, opts)
	opts = opts or {}
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, 0, 0)
	l.AutomaticSize = Enum.AutomaticSize.Y
	l.TextWrapped = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Font = opts.bold and Enum.Font.SourceSansBold or Enum.Font.SourceSans
	l.TextSize = opts.size or 14
	l.Text = text
	l.RichText = true
	l.LayoutOrder = nextOrder()
	l.Parent = root
	table.insert(themed, function()
		l.TextColor3 = color(opts.dim and Enum.StudioStyleGuideColor.DimmedText or Enum.StudioStyleGuideColor.MainText)
	end)
	return l
end

local function textBox(placeholder, editable)
	local b = Instance.new("TextBox")
	b.Size = UDim2.new(1, 0, 0, 26)
	b.ClearTextOnFocus = false
	b.TextEditable = editable
	b.PlaceholderText = placeholder
	b.Font = Enum.Font.Code
	b.TextSize = 13
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextTruncate = Enum.TextTruncate.AtEnd
	b.Text = ""
	b.LayoutOrder = nextOrder()
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, 6)
	p.PaddingRight = UDim.new(0, 6)
	p.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Parent = b
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
	b.Parent = root
	table.insert(themed, function()
		b.BackgroundColor3 = color(Enum.StudioStyleGuideColor.InputFieldBackground)
		b.TextColor3 = color(Enum.StudioStyleGuideColor.MainText)
		b.PlaceholderColor3 = color(Enum.StudioStyleGuideColor.DimmedText)
		stroke.Color = color(Enum.StudioStyleGuideColor.InputFieldBorder)
	end)
	return b
end

local function button(text, primary)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 28)
	b.Font = Enum.Font.SourceSansBold
	b.TextSize = 14
	b.Text = text
	b.AutoButtonColor = true
	b.LayoutOrder = nextOrder()
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
	b.Parent = root
	table.insert(themed, function()
		if primary then
			b.BackgroundColor3 = color(Enum.StudioStyleGuideColor.DialogMainButton)
			b.TextColor3 = color(Enum.StudioStyleGuideColor.DialogMainButtonText)
		else
			b.BackgroundColor3 = color(Enum.StudioStyleGuideColor.Button)
			b.TextColor3 = color(Enum.StudioStyleGuideColor.ButtonText)
		end
	end)
	return b
end

