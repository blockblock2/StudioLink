local function applyTheme()
	root.BackgroundColor3 = color(Enum.StudioStyleGuideColor.MainBackground)
	root.ScrollBarImageColor3 = color(Enum.StudioStyleGuideColor.ScrollBar)
	for _, f in ipairs(themed) do
		f()
	end
end
applyTheme()
settings().Studio.ThemeChanged:Connect(function()
	theme = settings().Studio.Theme
	applyTheme()
end)

local activity = {}
local function logActivity(text)
	table.insert(activity, 1, os.date("%H:%M:%S") .. "  " .. text)
	while #activity > 12 do
		table.remove(activity)
	end
	activityLabel.Text = table.concat(activity, "\n")
end

local function setStatus(state, detail)
	if state == "connected" then
		statusLabel.Text = '<font color="#3fb950">●</font> Connected' .. (detail and (" — " .. detail) or "")
	elseif state == "connecting" then
		statusLabel.Text = '<font color="#d29922">●</font> Connecting…'
	elseif state == "error" then
		statusLabel.Text = '<font color="#f85149">●</font> ' .. (detail or "Error")
	else
		statusLabel.Text = '<font color="#8b949e">●</font> Not connected'
	end
end

local function refreshConnector()
	connectorBox.Text = connectorUrl()
end
refreshConnector()

--------------------------------------------------------------------------------
-- Connection loop
--------------------------------------------------------------------------------

local running = false
local loopId = 0
local handled = {} -- id -> cached result body (or true while running)
local handledOrder = {}

local function post(path, body)
	return pcall(function()
		return HttpService:RequestAsync({
			Url = serverUrl .. "/plugin/" .. token .. path,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(body),
		})
	end)
end

local function encodeResult(id, ok, value)
	local body = { id = id, ok = ok }
	if ok then
		if type(value) == "table" then
			local okEnc, encoded = pcall(HttpService.JSONEncode, HttpService, value)
			body.result = okEnc and encoded or tostring(value)
		else
			body.result = value == nil and "(done)" or tostring(value)
		end
	else
		body.error = tostring(value)
	end
	return body
end

local function handleCommand(cmd)
	local id = cmd.id
	if handled[id] == true then
		return -- still running from an earlier delivery
	elseif type(handled[id]) == "table" then
		post("/result", handled[id]) -- re-send a result that got lost
		return
	end
	handled[id] = true
	table.insert(handledOrder, id)
	if #handledOrder > 200 then
		handled[table.remove(handledOrder, 1)] = nil
	end

	local fn = Commands[cmd.name]
	local ok, value
	if not fn then
		ok, value = false, "This plugin doesn't know the command " .. tostring(cmd.name) .. ". Update the Studio Link plugin."
	else
		ok, value = pcall(fn, cmd.args or {})
	end
	local body = encodeResult(id, ok, value)
	handled[id] = body
	logActivity((ok and "✓ " or "✗ ") .. tostring(cmd.name) .. ((cmd.args and cmd.args.path) and (" " .. tostring(cmd.args.path)) or ""))
	post("/result", body)
end

local function stop()
	running = false
	loopId += 1
	connectButton.Text = "Connect"
	setStatus("idle")
end

local function start()
	serverUrl = cleanUrl(urlBox.Text)
	urlBox.Text = serverUrl
	plugin:SetSetting(SETTING_URL, serverUrl)
	refreshConnector()
	if serverUrl == "" then
		setStatus("error", "Enter your relay URL first")
		return
	end
	running = true
	loopId += 1
	local myLoop = loopId
	plugin:SetSetting(SETTING_AUTO, true)
	connectButton.Text = "Disconnect"
	setStatus("connecting")

	task.spawn(function()
		local failures = 0
		while running and myLoop == loopId do
			local startedAt = os.clock()
			local ok, res = post("/poll", {
				place = game.Name,
				placeId = game.PlaceId,
				version = VERSION,
				github = githubConfig(),
			})
			if myLoop ~= loopId then
				break
			end
			if ok and res.Success then
				failures = 0
				setStatus("connected", game.Name)
				local okDecode, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
				local count = 0
				if okDecode and type(data) == "table" and type(data.commands) == "table" then
					for _, cmd in ipairs(data.commands) do
						count += 1
						task.spawn(handleCommand, cmd)
					end
				else
					setStatus("error", "That URL isn't a Studio Link relay")
				end
				-- Safety net: an empty answer should take ~20s. If it came back fast,
				-- slow down so we can never flood Roblox's HTTP limit.
				if count == 0 and os.clock() - startedAt < 2 then
					task.wait(5)
				end
			else
				failures += 1
				local detail
				if ok then
					detail = ("Relay answered %d %s"):format(res.StatusCode, res.StatusMessage)
				else
					detail = tostring(res)
					if detail:lower():find("exceeded") or detail:lower():find("limit") then
						detail = "Roblox HTTP limit hit — waiting a minute before retrying"
						failures = math.max(failures, 30)
					elseif detail:find("not enabled") or detail:find("permission") or detail:find("denied") then
						detail = "HTTP blocked — allow this plugin's HTTP access in Plugins → Manage Plugins"
					end
				end
				-- Brief timeouts are normal on long polls; only show errors once they repeat
				if failures >= 2 then
					setStatus("error", detail)
				end
				task.wait(math.min(2 * failures, 60))
			end
		end
	end)
end

connectButton.MouseButton1Click:Connect(function()
	if running then
		plugin:SetSetting(SETTING_AUTO, false)
		stop()
	else
		start()
	end
end)

urlBox.FocusLost:Connect(function()
	serverUrl = cleanUrl(urlBox.Text)
	urlBox.Text = serverUrl
	plugin:SetSetting(SETTING_URL, serverUrl)
	refreshConnector()
end)

newTokenButton.MouseButton1Click:Connect(function()
	token = newToken()
	plugin:SetSetting(SETTING_TOKEN, token)
	refreshConnector()
	logActivity("New secret URL — update the connector in Claude")
	if running then
		start()
	end
end)

-- The connector box is read-only in practice: any typing is reverted.
connectorBox:GetPropertyChangedSignal("Text"):Connect(function()
	local want = connectorUrl()
	if connectorBox.Text ~= want then
		connectorBox.Text = want
	end
end)

local function selectConnector()
	connectorBox.CursorPosition = #connectorBox.Text + 1
	connectorBox.SelectionStart = 1
end
connectorBox.Focused:Connect(selectConnector)

-- Plugins can't write to the clipboard, so the button selects the link for a one-key copy.
local copyResetId = 0
copyButton.MouseButton1Click:Connect(function()
	if connectorUrl() == "" then
		copyButton.Text = "Enter the relay URL first"
	else
		connectorBox:CaptureFocus()
		selectConnector()
		copyButton.Text = "Selected — press ⌘C (Ctrl+C) to copy"
	end
	copyResetId += 1
	local myId = copyResetId
	task.delay(4, function()
		if myId == copyResetId then
			copyButton.Text = "Copy connector link"
		end
	end)
end)

--------------------------------------------------------------------------------
-- GitHub panel actions
--------------------------------------------------------------------------------

local githubBusy = false

local function saveGithubFields()
	githubRepo = repoBox.Text:gsub("^%s+", ""):gsub("%s+$", ""):gsub("^https?://github%.com/", ""):gsub("%.git$", ""):gsub("/+$", "")
	githubBranch = branchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
	if githubBranch == "" then
		githubBranch = "main"
	end
	repoBox.Text = githubRepo
	branchBox.Text = githubBranch
	plugin:SetSetting(SETTING_GH_REPO, githubRepo)
	plugin:SetSetting(SETTING_GH_BRANCH, githubBranch)
end
repoBox.FocusLost:Connect(saveGithubFields)
branchBox.FocusLost:Connect(saveGithubFields)

local function refreshAutoButton()
	autoButton.Text = githubAutoPush and ("Auto-push: ON (every %d min)"):format(AUTO_PUSH_SECONDS // 60) or "Auto-push: OFF"
end
refreshAutoButton()

local function githubRequest(op, body)
	if serverUrl == "" then
		error("Enter your relay URL first", 0)
	end
	if githubRepo == "" then
		error("Enter your GitHub repo (owner/name) first", 0)
	end
	body.github = githubConfig()
	local ok, res = post("/github/" .. op, body)
	if not ok then
		error(tostring(res), 0)
	end
	local okDecode, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
	if not okDecode or type(data) ~= "table" then
		error(("Relay answered %d %s"):format(res.StatusCode, res.StatusMessage), 0)
	end
	if not data.ok then
		error(tostring(data.error), 0)
	end
	return data
end

local function githubPush(message)
	local data = githubRequest("push", { files = exportScripts(), message = message })
	return data.message
end

local function runGithub(label, fn)
	if githubBusy then
		return
	end
	githubBusy = true
	githubLabel.Text = label .. "…"
	task.spawn(function()
		local ok, result = pcall(fn)
		githubBusy = false
		local text = tostring(result)
		githubLabel.Text = (ok and "✓ " or "✗ ") .. text
		logActivity((ok and "✓ " or "✗ ") .. label)
	end)
end

pushButton.MouseButton1Click:Connect(function()
	saveGithubFields()
	runGithub("Pushing to GitHub", function()
		return githubPush(nil)
	end)
end)

pullButton.MouseButton1Click:Connect(function()
	saveGithubFields()
	runGithub("Pulling from GitHub", function()
		local data = githubRequest("pull", {})
		if type(data.files) ~= "table" or #data.files == 0 then
			return "No scripts found in the repo's \"" .. SYNC_FOLDER .. "\" folder"
		end
		return importScripts(data.files)
	end)
end)

autoButton.MouseButton1Click:Connect(function()
	githubAutoPush = not githubAutoPush
	plugin:SetSetting(SETTING_GH_AUTO, githubAutoPush)
	refreshAutoButton()
end)

local autoLoopAlive = true
task.spawn(function()
	while autoLoopAlive do
		task.wait(AUTO_PUSH_SECONDS)
		if autoLoopAlive and githubAutoPush and running and githubRepo ~= "" and not githubBusy then
			runGithub("Auto-push", function()
				return githubPush("Auto-sync from Roblox Studio")
			end)
		end
	end
end)

plugin.Unloading:Connect(function()
	autoLoopAlive = false
	running = false
	loopId += 1
	outputConn:Disconnect()
end)

if plugin:GetSetting(SETTING_AUTO) and serverUrl ~= "" then
	start()
end
]]></ProtectedString>
		</Properties>
	</Item>
</roblox>
